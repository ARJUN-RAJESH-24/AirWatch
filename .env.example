# AirWatch Environment Configuration Template
# Copy this file to .env and configure values for your environment.
# DO NOT COMMIT REAL SECRETS TO VERSION CONTROL.

# ------------------------------------------------------------------------------
# 1. DATABASE CONFIGURATION
# ------------------------------------------------------------------------------
# Local SQLite fallback (Zero-dependency development)
DATABASE_URL=sqlite://airwatch.db

# Docker / Production PostgreSQL Connection:
# DATABASE_URL=postgres://airwatch:your_strong_password_here@localhost:5432/airwatch

# PostgreSQL Container Credentials (used by docker-compose)
POSTGRES_DB=airwatch
POSTGRES_USER=airwatch
POSTGRES_PASSWORD=replace_with_strong_password_in_production

# ------------------------------------------------------------------------------
# 2. APPLICATION SERVER (RUST AXUM)
# ------------------------------------------------------------------------------
HOST=0.0.0.0
PORT=3001
CORS_ORIGIN=*
RUST_LOG=airwatch_backend=info,tower_http=info

# Admin API Key for triggering protected data ingestion runs
ADMIN_API_KEY=replace_with_random_secret_token_in_production

# ------------------------------------------------------------------------------
# 3. OFFICIAL INDIAN GOVERNMENT DATA SOURCES
# ------------------------------------------------------------------------------
# Government of India Open Government Data (data.gov.in) API Key
# Register and generate an API key at https://data.gov.in/
# The platform continues functioning using offline CPCB data assets if omitted.
DATAGOVIN_API_KEY=

# ------------------------------------------------------------------------------
# 4. AWS CLOUD DEPLOYMENT (OPTIONAL - ONLY CONFIGURE IF DEPLOYING TO AWS)
# ------------------------------------------------------------------------------
AWS_REGION=ap-south-1
# S3 Bucket for Raw CAAQMS CSV Archive & Provenance Manifests
# AWS_S3_RAW_BUCKET=airwatch-raw-provenance-archive
# AWS_CLOUDWATCH_METRIC_NAMESPACE=AirWatch/CAAQMS
